# Copy this file to .env and fill in real values. Never commit .env.

# --- PostgreSQL (used by docker-compose to configure the `db` service) ---
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=ticket_sales

# PostgreSQL connection string used by the app (psycopg 3 driver).
# Host is `localhost:5433` for running the API outside Docker (matches the
# host port docker-compose exposes for `db`, 5433:5432, to avoid clashing
# with a local Postgres on the default 5432); docker-compose overrides this
# to point at the `db` service (internal port 5432) for the `api` container.
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5433/ticket_sales

# Secret used to sign/verify JWT access tokens. Generate with: openssl rand -hex 32
JWT_SECRET=CHANGE_ME

# Secret used to sign/verify the HMAC of ticket QR codes. Generate with: openssl rand -hex 32
QR_SECRET_KEY=CHANGE_ME

# TMDb v4 Read Access Token (NOT the short v3 "API Key") — sent as a Bearer
# token. Get yours at https://www.themoviedb.org/settings/api, under
# "API Read Access Token".
TMDB_API_KEY=your-tmdb-v4-read-access-token-here

# Business rule timers (minutes/hours)
SEAT_HOLD_MINUTES=5
TRANSFER_EXPIRY_HOURS=24
CANCEL_WINDOW_HOURS=2

# Comma-separated list of origins allowed to call the API via CORS.
# In production, set this to the deployed frontend's URL(s), e.g.
# CORS_ORIGINS=https://ticket-sales-frontend.vercel.app
CORS_ORIGINS=http://localhost:5173
