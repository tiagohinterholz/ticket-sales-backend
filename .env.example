# Copy this file to .env and fill in real values. Never commit .env.

# PostgreSQL connection string (psycopg 3 driver)
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/ticket_sales

# Secret used to sign/verify JWT access tokens. Generate with: openssl rand -hex 32
JWT_SECRET=CHANGE_ME

# Secret used to sign/verify the HMAC of ticket QR codes. Generate with: openssl rand -hex 32
QR_SECRET_KEY=CHANGE_ME

# TMDb API key (https://www.themoviedb.org/settings/api)
TMDB_API_KEY=your-tmdb-api-key-here

# Business rule timers (minutes/hours)
SEAT_HOLD_MINUTES=5
TRANSFER_EXPIRY_HOURS=24
CANCEL_WINDOW_HOURS=2
